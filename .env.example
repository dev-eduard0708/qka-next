# QKA-Next local development. Copy to .env and fill locally.
# Never commit secrets. Never point this at production.

QKA_DATABASE_URL=postgresql+psycopg://qka_test@127.0.0.1:55432/qka_next_dev
QKA_DATABASE_READ_ONLY=true

QKA_API_HOST=127.0.0.1
QKA_API_PORT=5265
QKA_CORS_ORIGINS=http://127.0.0.1:5186
QKA_FRONTEND_ORIGIN=http://127.0.0.1:5186
QKA_ENVIRONMENT=development
QKA_COOKIE_SECURE=false

# HMAC session secret (generate a long random string). Not an OpenAI or Google key.
QKA_SESSION_SECRET=replace-with-a-long-random-dev-secret
QKA_SESSION_HOURS=8

# Email-only DEV login. Default off. Ignored when QKA_ENVIRONMENT=production.
QKA_DEV_SESSION_ENABLED=false

# Local Super Admin password login. Username defaults to super.
# Leave password empty in development to use the local bootstrap default. Never use that default in production.
QKA_LOCAL_ADMIN_USERNAME=super
QKA_LOCAL_ADMIN_PASSWORD=

# Google Workspace OIDC (authorization code + PKCE). Leave empty until Cloud Console is configured.
# See docs/05-GOOGLE-OIDC.md. Never put these values in the frontend.
QKA_GOOGLE_CLIENT_ID=
QKA_GOOGLE_CLIENT_SECRET=
QKA_GOOGLE_REDIRECT_URI=http://127.0.0.1:5186/api/v1/auth/google/callback
QKA_GOOGLE_HOSTED_DOMAIN=qehc.edu.sa
QKA_GOOGLE_AUTHORITY=https://accounts.google.com

# Pilot folder / share scoping for DEV copy search. Not a shared BoundUserId for Google users.
QKA_PILOT_FOLDER_PREFIX=EDUARDTESTCLOUD
# connection = index all files Sync discovers under the configured share/folders (recommended).
# pilot = restrict automatic extraction to QKA_PILOT_FOLDER_PREFIX only (legacy).
QKA_INDEXING_SCOPE_MODE=connection
QKA_APPROVED_SHARE_ID=533398e3-3f65-457e-adc8-abc318abb063

# Fernet credential key for Synology secrets. Falls back to QKA_SESSION_SECRET if empty.
QKA_CREDENTIAL_KEY=

# Optional comma-separated NAS hosts allowed for SMB (example: 192.168.110.11). Empty allows any valid UNC host.
QKA_SMB_ALLOWED_HOSTS=

# Embedded Synology worker inside the API process. Standalone qka-worker also polls every 2 seconds.
QKA_WORKER_EMBEDDED=true

# Native OpenAI chat (server-side only; never expose to Quasar). Prefer OPENAI_API_KEY.
OPENAI_API_KEY=
# QKA_OPENAI_API_KEY=
QKA_OPENAI_MODEL=gpt-4.1-mini
QKA_OPENAI_MAX_OUTPUT_TOKENS=2048
QKA_OPENAI_MAX_CONTEXT_CHARS=48000
QKA_OPENAI_MAX_HISTORY_MESSAGES=24
QKA_OPENAI_UPLOAD_MAX_BYTES=5000000
# Must be explicitly true before Synology/sample document text is sent to OpenAI.
QKA_OPENAI_DATA_SHARING_PERMITTED=false

# MCP / ChatGPT Business staging (QKA-Next :5265 only — never overwrite legacy :5255)
QKA_MCP_OAUTH_ENABLED=false
QKA_MCP_PUBLIC_BASE_URL=http://127.0.0.1:5265
QKA_MCP_RESOURCE_PATH=/mcp
QKA_MCP_DOCUMENTS_SCOPE=mcp:documents.read
QKA_MCP_GOOGLE_REDIRECT_PATH=/oauth/google/callback
# 0 = no time expiry after company Google login (default). Set e.g. 3600 to restore hourly access tokens.
# QKA_MCP_OAUTH_ACCESS_TOKEN_SECONDS=0
# QKA_MCP_OAUTH_REFRESH_TOKEN_SECONDS=0
# Inspector-only static bearer (DEV). Bind to ONE individual QkaUser — never a shared pilot for all employees.
QKA_MCP_INSPECTOR_BEARER=
QKA_MCP_INSPECTOR_USER_ID=
QKA_MCP_ADDITIONAL_ALLOWED_RESOURCES=
QKA_MCP_TUNNEL_READY_URL=http://127.0.0.1:8081/readyz
QKA_MCP_CHATGPT_PLUGIN_NAME=QKA-Next DEV – QEC Knowledge AI
QKA_MCP_CHATGPT_ENVIRONMENT=staging
# Deprecated/ignored for Live Verified. Dashboard derives Live Verified only from MCP audit rows tagged client=chatgpt.
QKA_MCP_CHATGPT_LIVE_VERIFIED_AT=

# Windows Desktop Agent (pilot). Employee PCs must use reachable internal HTTPS — not localhost.
# QKA_AGENT_PUBLIC_BASE_URL=https://qka.internal.qehc.edu.sa
# QKA_AGENT_ENROLLMENT_HOURS=24
# QKA_AGENT_MIN_VERSION=0.1.0

# LibreOffice headless path for original-format Office preview (soffice.exe).
# QKA_LIBREOFFICE_PATH=C:\\Program Files\\LibreOffice\\program\\soffice.exe


# Local OCR (Tesseract). Preferred install path on this host:
# QKA_TESSERACT_PATH=C:\\QehcAI\\Temp\\tesseract\\tesseract.exe
# QKA_OCR_TIMEOUT_SECONDS=120
# QKA_EXTRACTION_MAX_PAGES=100
# QKA_EXTRACTION_MAX_FILE_BYTES=40000000
# QKA_EXTRACTION_MAX_CHARS=500000
# QKA_EXTRACTION_CONCURRENCY=1
